# Copie para .env e preencha. Nunca versione o .env.
DEBUG=0
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Chave AES-256 (32 bytes em base64) das credenciais de WhatsApp. Gere com:
# python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=
# Segredo do endpoint /api/cron/tick/ (agendador externo, quando não houver worker)
CRON_SECRET=
ALLOWED_HOSTS=efind.com.br,www.efind.com.br
# URL pública (usada nos links/QR Codes de cadastro e na URL do webhook do WhatsApp)
APP_URL=https://efind.com.br

# Banco MariaDB (veja docs/MARIADB.md)
DB_NAME=efind
DB_USER=efind
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Identificação exigida pelo Nominatim/OpenStreetMap na geocodificação
GEOCODER_USER_AGENT=E-Find/1.0 (contato@efind.com.br)
# Super admin criado por "python manage.py seed_demo" / "createsuperuser"
SEED_SUPERADMIN_EMAIL=super@efind.com.br
SEED_SUPERADMIN_PASSWORD=
