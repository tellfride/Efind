# Banco de dados. Desenvolvimento: SQLite. Produção: PostgreSQL
# (troque provider = "postgresql" em prisma/schema.prisma e use a URL do Postgres)
DATABASE_URL="file:./dev.db"

# URL pública do sistema (usada nos links/QR Codes de cadastro e no webhook do WhatsApp)
APP_URL="https://efind.com.br"
NEXT_PUBLIC_APP_URL="https://efind.com.br"

# Segredo da sessão (mín. 32 caracteres). Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Chave AES-256 (32 bytes em base64) que criptografa as credenciais das APIs de WhatsApp. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Segredo para o endpoint /api/cron/tick (usado por agendadores externos quando não houver worker)
CRON_SECRET=""

# Identificação exigida pelo Nominatim/OpenStreetMap para geocodificação
GEOCODER_USER_AGENT="E-Find/1.0 (contato@efind.com.br)"

# Usuário super admin criado pelo seed
SEED_SUPERADMIN_EMAIL="super@efind.com.br"
SEED_SUPERADMIN_PASSWORD=""
